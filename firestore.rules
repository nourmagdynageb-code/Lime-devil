rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.type in ['msg', 'system']
        && request.resource.data.ts is number
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'm');

      // Needed by the browser purge routine.
      // For production-grade security, move purge deletion to a trusted backend/Cloud Function.
      allow delete: if request.auth != null;
      allow update: if false;
    }

    match /presence/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.uid != null;
    }

    match /meta/purge {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
